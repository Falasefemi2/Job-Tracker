# Binaries and build output (rooted so cmd/jobtracker and cmd/migrate sources are not ignored)
/jobtracker
/jobtracker.exe
/migrate
/migrate.exe
/bin/
/dist/
/build/
*.exe
*.dll
*.so
*.dylib
*.test
*.out

# Go workspace and cache
/vendor/
go.work
go.work.sum

# Test and coverage artifacts
coverage.out
coverage.html
*.coverprofile
/tmp/

# Environment and secrets - never commit these
.env
.env.local
.env.*.local
!.env.example

# Exported data - generated by `task export`
applications-*.csv
*.csv
!migrations/**/*.csv

# Task runner cache
.task/
.taskcache/

# IDE and editors
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
logs/
